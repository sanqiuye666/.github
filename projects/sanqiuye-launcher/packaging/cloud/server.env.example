# 私有配置示例，路径与地址均须替换；不要提交真实配置或凭据。
SQY_SERVER_ENABLED=true
SQY_SERVER_MODE=real
SQY_ROLE=server
SQY_TARGET_NAME=account-api
SQY_ACCOUNTS_ENABLED=true
SQY_REGISTRATION_ENABLED=true
SQY_MANAGED_PACKS_ENABLED=false
SQY_PLAYER_REPORTS_ENABLED=false
SQY_SSH_ENABLED=false
SQY_RCON_ENABLED=false
SQY_LOG_DIR=<ABSOLUTE_PRIVATE_LOG_DIRECTORY>
SQY_RETRY_MAX=1
SQY_ALLOW_LOOPBACK_HTTP=false
SQY_CLOUD_ADMIN_TOKEN_FILE=<ABSOLUTE_PRIVATE_ADMIN_TOKEN_FILE>
SQY_HTTP_BIND_HOST=localhost
SQY_HTTP_BIND_PORT=<UNUSED_INTERNAL_PORT>
SQY_ACCOUNT_DB_PATH=<ABSOLUTE_PRIVATE_ACCOUNT_DB_FILE>
SQY_SESSION_SECRET_FILE=<ABSOLUTE_PRIVATE_SESSION_SECRET_FILE>
SQY_DEFAULT_GROUP_ID=default
