# 三秋叶服务器能力示例。复制到仓库外的私有配置文件，通过 SQY_CONFIG_FILE 指定其绝对路径。
# 不要在此填写真实地址、密钥、密码或token。环境变量优先于配置文件。
SQY_SERVER_ENABLED=false
SQY_SERVER_MODE=mock
SQY_ROLE=player
SQY_ACCOUNTS_ENABLED=false
SQY_REGISTRATION_ENABLED=false
SQY_MANAGED_PACKS_ENABLED=false
SQY_PLAYER_REPORTS_ENABLED=false
SQY_SSH_ENABLED=false
SQY_RCON_ENABLED=false
SQY_AUTO_ROLLBACK_ENABLED=true
SQY_DEFAULT_GROUP_ID=default
SQY_MOCK_SCENARIO=success
# mock开启时必填两个互不嵌套的专用绝对目录；玩家端和管理端使用同一个状态目录。
# SQY_MOCK_STATE_DIR=<ABSOLUTE_PRIVATE_MOCK_STATE_DIRECTORY>
# SQY_LOG_DIR=<ABSOLUTE_PRIVATE_LOG_DIRECTORY>
# real目前接入面板账号；SSH/RCON/真实整合包仍未接入，不会退回mock。
# 公网必须HTTPS；安全隧道联调才可显式开启下项，且仅允许回环HTTP。
SQY_ALLOW_LOOPBACK_HTTP=false
# SQY_CLOUD_ADMIN_TOKEN_FILE=<PRIVATE_ADMIN_TOKEN_FILE>
# SQY_TARGET_NAME=<TARGET_ALIAS>
# SQY_API_BASE_URL=<HTTPS_API_BASE_URL>
# SQY_SSH_HOST=<SSH_HOST>
# SQY_SSH_PORT=<SSH_PORT>
# SQY_SSH_USER=<SSH_USER>
# SQY_SSH_KEY_PATH=<PRIVATE_KEY_FILE_PATH>
# SQY_SSH_KNOWN_HOSTS_PATH=<KNOWN_HOSTS_FILE>
# SQY_REMOTE_ROOT=<DEDICATED_REMOTE_ROOT>
# SQY_REMOTE_SERVICE_NAME=<DEDICATED_SERVICE_NAME>
# SQY_REMOTE_JAVA_HOME=<REMOTE_JAVA_HOME>
# SQY_HTTP_BIND_HOST=<LOCAL_BIND_HOST>
# SQY_HTTP_BIND_PORT=<UNUSED_INTERNAL_PORT>
# SQY_PROTECTED_PORTS=<COMMA_SEPARATED_PROTECTED_PORTS>
# SQY_ACCOUNT_DB_PATH=<ACCOUNT_DB_FILE>
# SQY_SESSION_SECRET_FILE=<SESSION_SECRET_FILE>
# SQY_CREDENTIAL_STORE_PATH=<ENCRYPTED_SESSION_STORE>
# SQY_RCON_HOST=<LOCAL_RCON_HOST>
# SQY_RCON_PORT=<RCON_PORT>
# SQY_RCON_PASSWORD_FILE=<RCON_PASSWORD_FILE>
# SQY_BACKUP_DIR=<DEDICATED_BACKUP_DIRECTORY>
# SQY_PACK_STORAGE_ROOT=<PACK_STORAGE_DIRECTORY>
# SQY_SIGNING_KEY_FILE=<SIGNING_KEY_FILE>
SQY_RETRY_MAX=1
SQY_RETRY_BASE_MS=500
SQY_RETRY_MAX_MS=2000
SQY_TIMEOUT_CONNECT_MS=10000
SQY_TIMEOUT_RUNTIME_MS=15000
SQY_TIMEOUT_SERVICE_MS=60000
SQY_TIMEOUT_SESSION_MS=15000
SQY_TIMEOUT_DIRECTORY_MS=15000
SQY_TIMEOUT_CONTENT_MS=120000
SQY_TIMEOUT_FILE_MS=120000
SQY_TIMEOUT_PUBLISH_MS=60000
SQY_TIMEOUT_RCON_MS=10000
SQY_TIMEOUT_WORLD_SAVE_MS=30000
SQY_TIMEOUT_DB_MS=5000
SQY_TIMEOUT_BACKUP_MS=180000
SQY_TIMEOUT_DEPLOY_MS=90000
SQY_TIMEOUT_UPLOAD_MS=600000
SQY_IDEMPOTENCY_TTL_SECONDS=86400
SQY_MAX_UPLOAD_BYTES=1073741824
SQY_MAX_EXTRACTED_BYTES=4294967296
SQY_MAX_ARCHIVE_ENTRIES=100000
SQY_PACK_DELETE_RETENTION_DAYS=7
